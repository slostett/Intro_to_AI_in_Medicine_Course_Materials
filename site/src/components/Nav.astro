---
import { BASE } from '../lib/constants';
---

<header class="sticky top-0 z-50 bg-paper/90 backdrop-blur-sm border-b border-rule">
  <nav class="max-w-content mx-auto px-6 h-14 flex items-center justify-between">
    <a href={`${BASE}/`} class="text-ink font-semibold text-[15px] tracking-tight no-underline hover:opacity-70 transition-opacity">
      Intro to AI in Medicine
    </a>
    <div class="flex items-center gap-8">
      <a href={`${BASE}/syllabus`} class="text-[15px] text-ink-secondary no-underline hover:text-ink transition-colors">
        Syllabus
      </a>
      <a href={`${BASE}/project`} class="text-[15px] text-ink-secondary no-underline hover:text-ink transition-colors">
        Project
      </a>
      <a href={`${BASE}/resources`} class="text-[15px] text-ink-secondary no-underline hover:text-ink transition-colors">
        Resources
      </a>
      <a
        href="https://github.com/slostett/Intro_to_AI_in_Medicine_Course_Materials"
        target="_blank"
        rel="noopener noreferrer"
        class="text-[15px] text-ink-secondary no-underline hover:text-ink transition-colors"
      >
        GitHub ↗
      </a>
    </div>
  </nav>
</header>
