---
import Base from '../layouts/Base.astro';
import { resources } from '../data/resources';

const categoryLabels: Record<string, string> = {
  paper: 'Papers & Articles',
  book: 'Books',
  demo: 'Interactive Demos',
  notebook: 'Notebooks',
  video: 'Videos',
  platform: 'Platforms & Repositories',
};

const categoryOrder = ['paper', 'book', 'demo', 'notebook', 'video', 'platform'];

const grouped: Record<string, typeof resources> = {};
for (const r of resources) {
  if (!grouped[r.type]) grouped[r.type] = [];
  grouped[r.type].push(r);
}
---

<Base
  title="Resources: Introduction to AI in Medicine"
  description="Curated readings, demos, videos, and references for the course."
>

  <section class="section-band">
    <div class="content-col reveal-on-scroll">
      <p class="section-label">Reference Library</p>
      <h1>Resources</h1>
      <p class="mt-6 text-lg text-ink-secondary max-w-2xl leading-relaxed">
        Curated readings, interactive demos, videos, and references organized by category.
        Use these to deepen your understanding of course topics.
      </p>
    </div>
  </section>

  <!-- Resource categories -->
  {categoryOrder.map(category => {
    const items = grouped[category];
    if (!items || items.length === 0) return null;
    return (
      <section class="section-band-alt">
        <div class="content-col reveal-on-scroll">
          <h2 class="mb-8">{categoryLabels[category]}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
            {items.map(item => (
              <div class="border-b border-rule pb-6">
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[17px] font-medium text-ink no-underline hover:text-accent transition-colors"
                >
                  {item.title}
                </a>
                {item.authors && (
                  <p class="mt-1 text-[15px] text-ink-secondary">{item.authors}</p>
                )}
                {item.publication && item.year && (
                  <p class="mt-0.5 text-[15px] text-ink-secondary/70">
                    {item.publication}{item.year ? `, ${item.year}` : ''}
                  </p>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>
    );
  })}

</Base>
