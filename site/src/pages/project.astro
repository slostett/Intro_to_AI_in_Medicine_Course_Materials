---
import Base from '../layouts/Base.astro';
---

<Base
  title="Final Project — Introduction to AI in Medicine"
  description="Final project guidelines and selected student examples."
>

  <!-- Project brief -->
  <section class="section-band">
    <div class="content-col reveal-on-scroll">
      <p class="section-label">Final Project</p>
      <h1>Build Something<br/>That Matters</h1>
      <div class="mt-10 max-w-2xl space-y-6 text-[17px] text-ink-secondary leading-relaxed">
        <p>
          Students explore clinically relevant questions using AI methods discussed throughout the course,
          with emphasis on interpretability, evaluation, and real-world relevance.
        </p>
        <p>
          The project is designed to bridge the gap between conceptual understanding and practical application.
          You'll formulate a clinical question, select or adapt an AI method, evaluate it critically,
          and present your findings.
        </p>
      </div>
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/Final%20Project%20Deliverables.docx"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-rule text-ink px-5 py-2.5 rounded-full text-[15px] no-underline hover:border-ink transition-colors"
        >
          Download Guidelines ↗
        </a>
        <a
          href="/Lecture%20Slides/Lec%2012%20Project%20Intro.pptx"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-rule text-ink px-5 py-2.5 rounded-full text-[15px] no-underline hover:border-ink transition-colors"
        >
          Project Intro Slides ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Student examples -->
  <section class="section-band-alt">
    <div class="content-col reveal-on-scroll">
      <p class="section-label">Student Work</p>
      <h2>Selected Projects</h2>
      <p class="mt-6 text-[17px] text-ink-secondary max-w-2xl leading-relaxed">
        Examples from previous terms. Each project demonstrates a different approach to applying AI
        to a clinical question.
      </p>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        <a
          href="/Student%20Final%20Project%20Examples/Future%20Internist%20Final%20Project.docx"
          target="_blank"
          rel="noopener noreferrer"
          class="group block border border-rule rounded-[18px] p-8 no-underline hover:border-ink/30 transition-colors"
        >
          <h3 class="text-lg font-semibold text-ink tracking-tighter group-hover:text-accent transition-colors">
            Future Internist
          </h3>
          <p class="mt-3 text-[15px] text-ink-secondary leading-relaxed">
            Final project exploring AI applications in general internal medicine practice.
          </p>
          <p class="mt-4 text-sm text-ink-secondary inline-flex items-center gap-1">
            View project <span class="text-accent">↗</span>
          </p>
        </a>
        <a
          href="/Student%20Final%20Project%20Examples/Future%20Neurologist%20Final%20Project.docx"
          target="_blank"
          rel="noopener noreferrer"
          class="group block border border-rule rounded-[18px] p-8 no-underline hover:border-ink/30 transition-colors"
        >
          <h3 class="text-lg font-semibold text-ink tracking-tighter group-hover:text-accent transition-colors">
            Future Neurologist
          </h3>
          <p class="mt-3 text-[15px] text-ink-secondary leading-relaxed">
            Final project exploring AI applications in neurology and neurological disease.
          </p>
          <p class="mt-4 text-sm text-ink-secondary inline-flex items-center gap-1">
            View project <span class="text-accent">↗</span>
          </p>
        </a>
      </div>
    </div>
  </section>

</Base>
